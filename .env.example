# Copy to .env next to docker-compose.yml and run: chmod 600 .env
# Use two different long random values, e.g.: openssl rand -hex 24
API_KEY=
WB_PANEL_PASSWORD=

# Local timezone; daily usage limits reset at local midnight.
TZ=Asia/Shanghai

# 127.0.0.1 keeps the gateway reachable only from this host (SSH tunnel or reverse proxy).
WB_BIND_ADDRESS=127.0.0.1
WB_PORT=8788

# Pin a tested build for reproducible deployments, e.g.
# WB_IMAGE=ghcr.io/d3-3109/workbuddy2api-hub-rust:sha-<commit>
# WB_IMAGE=ghcr.io/d3-3109/workbuddy2api-hub-rust:edge
