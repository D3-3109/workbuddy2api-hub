# Copy to rust/deploy/.env and restrict to the deploying user (e.g. chmod 0600).
# Both secrets are intentionally empty: compose fails until you supply them.
# Use different random values. Do not use the default panel password "admin".
API_KEY=
WB_PANEL_PASSWORD=
TZ=Etc/UTC
WB_BIND_ADDRESS=127.0.0.1
WB_PORT=8788
