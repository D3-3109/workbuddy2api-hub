# Install a filled-in copy at /etc/wb2api/wb2api.env, root-owned mode 0600.
# systemd EnvironmentFile syntax: no "export", shell expansion or command substitution.
# Replace both placeholders with different random secrets before starting.
API_KEY=REPLACE_WITH_A_RANDOM_API_KEY
WB_PANEL_PASSWORD=REPLACE_WITH_A_RANDOM_NONDEFAULT_PANEL_PASSWORD
TZ=Etc/UTC
